{
  "name": "erp-importadora-tapia-frontapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "axios": "^1.13.2",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.0",
    "write-excel-file": "^4.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.6.2",
    "sass": "^1.95.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  },
  "description": "Front del ERP de Importadora Tapia. Vue 3 + Vite + TypeScript."
}
